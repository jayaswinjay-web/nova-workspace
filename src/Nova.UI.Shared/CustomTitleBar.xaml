<UserControl
    x:Class="Nova.UI.Shared.CustomTitleBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignHeight="48"
    d:DesignWidth="800">

    <Grid x:Name="TitleBarGrid" Height="48" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />  <!-- App Icon -->
            <ColumnDefinition Width="Auto" />  <!-- Document Title -->
            <ColumnDefinition Width="*" />     <!-- Spacer / Search -->
            <ColumnDefinition Width="Auto" />  <!-- Search Box -->
            <ColumnDefinition Width="Auto" />  <!-- Save Status -->
            <ColumnDefinition Width="Auto" />  <!-- Window Controls -->
        </Grid.ColumnDefinitions>

        <!-- App Icon -->
        <Image x:Name="AppIconImage"
               Source="{x:Bind AppIcon, Mode=OneWay}"
               Width="32" Height="32"
               Margin="12,8,8,8"
               VerticalAlignment="Center"
               Grid.Column="0" />

        <!-- Document Title -->
        <TextBlock x:Name="DocumentTitleText"
                   Text="{x:Bind DocumentTitle, Mode=OneWay}"
                   FontSize="14"
                   FontWeight="SemiBold"
                   VerticalAlignment="Center"
                   Margin="0,0,16,0"
                   TextTrimming="CharacterEllipsis"
                   MaxWidth="300"
                   Grid.Column="1" />

        <!-- Search Box -->
        <Grid x:Name="SearchBoxGrid"
              Grid.Column="3"
              Margin="0,8,16,8"
              Visibility="{x:Bind ShowSearchBox, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
              MinWidth="200"
              MaxWidth="400">
            <Border Background="{ThemeResource ControlFillColorDefaultBrush}"
                    CornerRadius="20"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    Padding="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <FontIcon x:Name="SearchIcon"
                              Glyph="&#xE721;"
                              FontSize="16"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                              VerticalAlignment="Center"
                              Margin="12,0,8,0"
                              Grid.Column="0" />

                    <TextBox x:Name="SearchBox"
                             PlaceholderText="{x:Bind SearchPlaceholder, Mode=OneWay}"
                             Background="Transparent"
                             BorderThickness="0"
                             FontSize="13"
                             VerticalAlignment="Center"
                             Padding="0,0,12,0"
                             Grid.Column="1"
                             KeyDown="OnSearchBoxKeyDown"
                             LostFocus="OnSearchBoxLostFocus" />

                    <Button x:Name="ClearSearchButton"
                            Style="{StaticResource TransparentButtonStyle}"
                            Visibility="Collapsed"
                            Grid.Column="2"
                            Padding="8,0,12,0"
                            Click="OnClearSearchClick">
                        <FontIcon Glyph="&#xE711;" FontSize="14" />
                    </Button>
                </Grid>
            </Border>
        </Grid>

        <!-- Save Status -->
        <Grid x:Name="SaveStatusGrid"
              Grid.Column="4"
              Margin="0,0,16,0"
              VerticalAlignment="Center"
              ToolTipService.ToolTip="Save Status">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Ellipse x:Name="SaveStatusIndicator"
                     Width="8" Height="8"
                     Fill="Green"
                     VerticalAlignment="Center"
                     Margin="0,0,6,0"
                     Grid.Column="0" />

            <TextBlock x:Name="SaveStatusText"
                       Text="Saved"
                       FontSize="11"
                       FontWeight="Medium"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       VerticalAlignment="Center"
                       Grid.Column="1" />
        </Grid>

        <!-- Window Controls -->
        <Grid x:Name="WindowControlsGrid"
              Grid.Column="5"
              HorizontalAlignment="Right">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button x:Name="MinimizeButton"
                    Style="{StaticResource TitleBarButtonStyle}"
                    ToolTipService.ToolTip="Minimize"
                    Visibility="{x:Bind CanMinimize, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                    Click="OnMinimizeClick"
                    Grid.Column="0">
                <FontIcon Glyph="&#xE921;" FontSize="12" />
            </Button>

            <Button x:Name="MaximizeButton"
                    Style="{StaticResource TitleBarButtonStyle}"
                    ToolTipService.ToolTip="Maximize"
                    Visibility="{x:Bind CanMaximize, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                    Click="OnMaximizeClick"
                    Grid.Column="1">
                <FontIcon x:Name="MaximizeIcon" Glyph="&#xE922;" FontSize="12" />
            </Button>

            <Button x:Name="CloseButton"
                    Style="{StaticResource TitleBarButtonStyle}"
                    ToolTipService.ToolTip="Close"
                    Visibility="{x:Bind CanClose, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                    Click="OnCloseClick"
                    Grid.Column="2">
                <FontIcon Glyph="&#xE711;" FontSize="12" />
            </Button>
        </Grid>
    </Grid>
</UserControl>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Nova.UI.Shared"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls">

    <!-- Converters -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="ms-appx:///Microsoft.UI.Xaml/DensityStyles/DefaultStyles.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- Boolean to Visibility Converter -->
    <controls:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />

    <!-- Ribbon Tab Item Style -->
    <Style TargetType="local:RibbonTab" x:Key="RibbonTabStyle">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:RibbonTab">
                    <Grid x:Name="RootGrid" Height="48" Background="Transparent">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="SelectionStates">
                                <VisualState x:Name="Unselected" />
                                <VisualState x:Name="Selected">
                                    <VisualState.Setters>
                                        <Setter Target="RootGrid.Background" Value="{ThemeResource ControlFillColorDefaultBrush}" />
                                        <Setter Target="HeaderText.Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                                        <Setter Target="GlyphIcon.Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="RootGrid.Background" Value="{ThemeResource ControlFillColorSecondaryBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="RootGrid.Background" Value="{ThemeResource ControlFillColorTertiaryBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0">
                            <FontIcon x:Name="GlyphIcon"
                                      Glyph="{TemplateBinding Glyph}"
                                      FontSize="16"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                      VerticalAlignment="Center"
                                      Margin="0,0,8,0"
                                      Visibility="{TemplateBinding Glyph, Converter={StaticResource StringToVisibilityConverter}}" />
                            <TextBlock x:Name="HeaderText"
                                       Text="{TemplateBinding Header}"
                                       FontSize="13"
                                       FontWeight="Medium"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Ribbon Group Style -->
    <Style TargetType="local:RibbonGroup" x:Key="RibbonGroupStyle">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:RibbonGroup">
                    <Border Background="{ThemeResource ControlFillColorDefaultBrush}"
                            CornerRadius="8"
                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            Margin="4,4,4,8"
                            Padding="8,4">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <ItemsControl ItemsSource="{TemplateBinding Controls}"
                                          Grid.Row="1">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="4" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>

                            <TextBlock Text="{TemplateBinding Header}"
                                       FontSize="11"
                                       FontWeight="Medium"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                       Margin="4,0,4,4"
                                       Grid.Row="0" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Ribbon Button Style -->
    <Style TargetType="Button" x:Key="RibbonButtonStyle">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="MinWidth" Value="32" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="RootGrid" Background="{TemplateBinding Background}" CornerRadius="4">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="RootGrid.Background" Value="{ThemeResource ControlFillColorSecondaryBrush}" />
                                        <Setter Target="RootGrid.BorderBrush" Value="{ThemeResource ControlStrokeColorSecondaryBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="RootGrid.Background" Value="{ThemeResource ControlFillColorTertiaryBrush}" />
                                        <Setter Target="RootGrid.BorderBrush" Value="{ThemeResource ControlStrokeColorSecondaryBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="RootGrid.Opacity" Value="0.4" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Checked">
                                    <VisualState.Setters>
                                        <Setter Target="RootGrid.Background" Value="{ThemeResource SystemAccentColorLight3Brush}" />
                                        <Setter Target="RootGrid.BorderBrush" Value="{ThemeResource SystemAccentColorBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CheckedPointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="RootGrid.Background" Value="{ThemeResource SystemAccentColorLight2Brush}" />
                                        <Setter Target="RootGrid.BorderBrush" Value="{ThemeResource SystemAccentColorBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CheckedPressed">
                                    <VisualState.Setters>
                                        <Setter Target="RootGrid.Background" Value="{ThemeResource SystemAccentColorLight1Brush}" />
                                        <Setter Target="RootGrid.BorderBrush" Value="{ThemeResource SystemAccentColorBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <ContentPresenter x:Name="ContentPresenter"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Margin="{TemplateBinding Padding}"
                                          AutomationProperties.AccessibilityView="Raw" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Ribbon Control Template Selector -->
    <DataTemplate x:Key="RibbonButtonTemplate" x:DataType="local:RibbonButton">
        <Button Style="{StaticResource RibbonButtonStyle}"
                Command="{x:Bind Command}"
                CommandParameter="{x:Bind CommandParameter}"
                ToolTipService.ToolTip="{x:Bind ToolTip}"
                IsEnabled="{x:Bind IsEnabled}"
                Visibility="{x:Bind IsVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                AutomationProperties.Name="{x:Bind Label}"
                AutomationProperties.HelpText="{x:Bind ToolTip}">
            <StackPanel Orientation="{x:Bind Size, Converter={StaticResource SizeToOrientationConverter}}"
                        Spacing="4">
                <FontIcon Glyph="{x:Bind Glyph}"
                          FontSize="{x:Bind Size, Converter={StaticResource SizeToFontSizeConverter}}"
                          Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                          Visibility="{x:Bind Glyph, Converter={StaticResource StringToVisibilityConverter}}" />
                <TextBlock Text="{x:Bind Label}"
                           FontSize="12"
                           FontWeight="Medium"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                           Visibility="{x:Bind Size, Converter={StaticResource SizeToLabelVisibilityConverter}}" />
            </StackPanel>
        </Button>
    </DataTemplate>

    <DataTemplate x:Key="RibbonToggleButtonTemplate" x:DataType="local:RibbonToggleButton">
        <ToggleButton Style="{StaticResource RibbonButtonStyle}"
                      Command="{x:Bind Command}"
                      IsChecked="{x:Bind IsChecked, Mode=TwoWay}"
                      ToolTipService.ToolTip="{x:Bind ToolTip}"
                      IsEnabled="{x:Bind IsEnabled}"
                      Visibility="{x:Bind IsVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                      AutomationProperties.Name="{x:Bind Label}"
                      AutomationProperties.HelpText="{x:Bind ToolTip}">
            <StackPanel Orientation="{x:Bind Size, Converter={StaticResource SizeToOrientationConverter}}"
                        Spacing="4">
                <FontIcon Glyph="{x:Bind Glyph}"
                          FontSize="{x:Bind Size, Converter={StaticResource SizeToFontSizeConverter}}"
                          Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                          Visibility="{x:Bind Glyph, Converter={StaticResource StringToVisibilityConverter}}" />
                <TextBlock Text="{x:Bind Label}"
                           FontSize="12"
                           FontWeight="Medium"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                           Visibility="{x:Bind Size, Converter={StaticResource SizeToLabelVisibilityConverter}}" />
            </StackPanel>
        </ToggleButton>
    </DataTemplate>

    <DataTemplate x:Key="RibbonSplitButtonTemplate" x:DataType="local:RibbonSplitButton">
        <SplitButton Style="{StaticResource RibbonButtonStyle}"
                     Command="{x:Bind Command}"
                     IsFlyoutOpen="{x:Bind IsDropDownOpen, Mode=TwoWay}"
                     ToolTipService.ToolTip="{x:Bind ToolTip}"
                     IsEnabled="{x:Bind IsEnabled}"
                     Visibility="{x:Bind IsVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                     AutomationProperties.Name="{x:Bind Label}"
                     AutomationProperties.HelpText="{x:Bind ToolTip}">
            <SplitButton.Content>
                <StackPanel Orientation="{x:Bind Size, Converter={StaticResource SizeToOrientationConverter}}"
                            Spacing="4">
                    <FontIcon Glyph="{x:Bind Glyph}"
                              FontSize="{x:Bind Size, Converter={StaticResource SizeToFontSizeConverter}}"
                              Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                              Visibility="{x:Bind Glyph, Converter={StaticResource StringToVisibilityConverter}}" />
                    <TextBlock Text="{x:Bind Label}"
                               FontSize="12"
                               FontWeight="Medium"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                               Visibility="{x:Bind Size, Converter={StaticResource SizeToLabelVisibilityConverter}}" />
                </StackPanel>
            </SplitButton.Content>
            <SplitButton.Flyout>
                <MenuFlyout>
                    <MenuFlyout.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="2" />
                        </ItemsPanelTemplate>
                    </MenuFlyout.ItemsPanel>
                </MenuFlyout>
            </SplitButton.Flyout>
        </SplitButton>
    </DataTemplate>

    <DataTemplate x:Key="RibbonDropDownButtonTemplate" x:DataType="local:RibbonDropDownButton">
        <DropDownButton Style="{StaticResource RibbonButtonStyle}"
                        IsFlyoutOpen="{x:Bind IsDropDownOpen, Mode=TwoWay}"
                        ToolTipService.ToolTip="{x:Bind ToolTip}"
                        IsEnabled="{x:Bind IsEnabled}"
                        Visibility="{x:Bind IsVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                        AutomationProperties.Name="{x:Bind Label}"
                        AutomationProperties.HelpText="{x:Bind ToolTip}">
            <DropDownButton.Content>
                <StackPanel Orientation="{x:Bind Size, Converter={StaticResource SizeToOrientationConverter}}"
                            Spacing="4">
                    <FontIcon Glyph="{x:Bind Glyph}"
                              FontSize="{x:Bind Size, Converter={StaticResource SizeToFontSizeConverter}}"
                              Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                              Visibility="{x:Bind Glyph, Converter={StaticResource StringToVisibilityConverter}}" />
                    <TextBlock Text="{x:Bind Label}"
                               FontSize="12"
                               FontWeight="Medium"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                               Visibility="{x:Bind Size, Converter={StaticResource SizeToLabelVisibilityConverter}}" />
                </StackPanel>
            </DropDownButton.Content>
            <DropDownButton.Flyout>
                <MenuFlyout>
                    <MenuFlyout.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="2" />
                        </ItemsPanelTemplate>
                    </MenuFlyout.ItemsPanel>
                </MenuFlyout>
            </DropDownButton.Flyout>
        </DropDownButton>
    </DataTemplate>

    <DataTemplate x:Key="RibbonComboBoxTemplate" x:DataType="local:RibbonComboBox">
        <ComboBox ItemsSource="{x:Bind Items}"
                  SelectedItem="{x:Bind SelectedItem, Mode=TwoWay}"
                  DisplayMemberPath="{x:Bind DisplayMemberPath}"
                  IsEnabled="{x:Bind IsEnabled}"
                  Visibility="{x:Bind IsVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                  Width="150"
                  PlaceholderText="{x:Bind PlaceholderText}"
                  AutomationProperties.Name="{x:Bind Label}"
                  ToolTipService.ToolTip="{x:Bind ToolTip}"
                  SelectionChanged="OnComboBoxSelectionChanged">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" />
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>
    </DataTemplate>

    <DataTemplate x:Key="RibbonTextBoxTemplate" x:DataType="local:RibbonTextBox">
        <TextBox Text="{x:Bind Text, Mode=TwoWay}"
                 PlaceholderText="{x:Bind PlaceholderText}"
                 MaxLength="{x:Bind MaxLength}"
                 IsEnabled="{x:Bind IsEnabled}"
                 Visibility="{x:Bind IsVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                 Width="150"
                 AutomationProperties.Name="{x:Bind Label}"
                 ToolTipService.ToolTip="{x:Bind ToolTip}"
                 TextChanged="OnTextBoxTextChanged" />
    </DataTemplate>

    <DataTemplate x:Key="RibbonCheckBoxTemplate" x:DataType="local:RibbonCheckBox">
        <CheckBox Content="{x:Bind Label}"
                  IsChecked="{x:Bind IsChecked, Mode=TwoWay}"
                  IsEnabled="{x:Bind IsEnabled}"
                  Visibility="{x:Bind IsVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                  ToolTipService.ToolTip="{x:Bind ToolTip}"
                  AutomationProperties.Name="{x:Bind Label}"
                  AutomationProperties.HelpText="{x:Bind ToolTip}" />
    </DataTemplate>

    <DataTemplate x:Key="RibbonSeparatorTemplate" x:DataType="local:RibbonSeparator">
        <Rectangle Width="1"
                   Height="24"
                   Fill="{ThemeResource ControlStrokeColorDefaultBrush}"
                   Margin="4,0"
                   VerticalAlignment="Stretch" />
    </DataTemplate>

    <DataTemplate x:Key="RibbonGalleryTemplate" x:DataType="local:RibbonGallery">
        <GridView ItemsSource="{x:Bind Items}"
                  SelectionMode="Single"
                  IsItemClickEnabled="True"
                  ItemClick="OnGalleryItemClick"
                  IsEnabled="{x:Bind IsEnabled}"
                  Visibility="{x:Bind IsVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                  AutomationProperties.Name="{x:Bind Label}">
            <GridView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsWrapGrid Orientation="Horizontal"
                                   MaximumRowsOrColumns="{x:Bind Columns}"
                                   ItemWidth="{x:Bind ItemWidth}"
                                   ItemHeight="{x:Bind ItemHeight}" />
                </ItemsPanelTemplate>
            </GridView.ItemsPanel>
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="local:RibbonGalleryItem">
                    <Border Background="{ThemeResource ControlFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="{x:Bind IsSelected, Converter={StaticResource BoolToThicknessConverter}, ConverterParameter=2}"
                            CornerRadius="4"
                            Padding="4">
                        <StackPanel Orientation="Vertical" Spacing="4">
                            <Image Source="{x:Bind Image}"
                                   Width="{x:Bind Width}"
                                   Height="{x:Bind Height}"
                                   Stretch="Uniform" />
                            <TextBlock Text="{x:Bind Label}"
                                       FontSize="11"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       MaxLines="2" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>
    </DataTemplate>

    <!-- Ribbon Tab Item Container Style -->
    <Style TargetType="ListViewItem" x:Key="RibbonTabContainerStyle">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinHeight" Value="48" />
    </Style>

    <!-- Ribbon Control Template -->
    <Style TargetType="local:Ribbon">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:Ribbon">
                    <Grid x:Name="RootGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="SizeStates">
                                <VisualState x:Name="Expanded" />
                                <VisualState x:Name="Compact">
                                    <VisualState.Setters>
                                        <Setter Target="TabList.Height" Value="36" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />  <!-- Tab Headers -->
                            <RowDefinition Height="Auto" />  <!-- Tab Content -->
                        </Grid.RowDefinitions>

                        <!-- Tab Headers -->
                        <ListView x:Name="TabList"
                                  ItemsSource="{TemplateBinding Tabs}"
                                  SelectedIndex="{TemplateBinding SelectedTabIndex, Mode=TwoWay}"
                                  ItemContainerStyle="{StaticResource RibbonTabContainerStyle}"
                                  SelectionMode="Single"
                                  Grid.Row="0"
                                  Height="48"
                                  Background="{ThemeResource LayerFillColorDefaultBrush}"
                                  BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                  BorderThickness="0,0,0,1">
                            <ListView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="0" />
                                </ItemsPanelTemplate>
                            </ListView.ItemsPanel>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local:RibbonTab">
                                    <ContentControl Style="{StaticResource RibbonTabStyle}" Content="{x:Bind}" />
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <!-- Tab Content -->
                        <ContentControl x:Name="TabContent"
                                        Grid.Row="1"
                                        Height="Auto"
                                        MinHeight="96"
                                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                        BorderThickness="0,0,0,1">
                            <ContentControl.ContentTemplate>
                                <DataTemplate x:DataType="local:RibbonTab">
                                    <ScrollViewer HorizontalScrollMode="Auto"
                                                  HorizontalScrollBarVisibility="Auto"
                                                  VerticalScrollMode="Disabled"
                                                  Padding="8,4">
                                        <ItemsControl ItemsSource="{x:Bind Groups}"
                                                      HorizontalAlignment="Left">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" Spacing="8" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="local:RibbonGroup">
                                                    <ContentControl Style="{StaticResource RibbonGroupStyle}" Content="{x:Bind}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </DataTemplate>
                            </ContentControl.ContentTemplate>
                        </ContentControl>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Quick Access Toolbar Style -->
    <Style TargetType="local:QuickAccessToolbar">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:QuickAccessToolbar">
                    <ItemsControl ItemsSource="{TemplateBinding Items}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="2" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ContentPresenter Content="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Converters for DataTemplates -->
    <local:SizeToOrientationConverter x:Key="SizeToOrientationConverter" />
    <local:SizeToFontSizeConverter x:Key="SizeToFontSizeConverter" />
    <local:SizeToLabelVisibilityConverter x:Key="SizeToLabelVisibilityConverter" />
    <local:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
    <local:BoolToThicknessConverter x:Key="BoolToThicknessConverter" />

</ResourceDictionary>